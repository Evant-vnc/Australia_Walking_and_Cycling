{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 5 (map 1). Each state's participation compared with Australia's average, one map per activity, on one shared scale (half to double). Hover a state to find it on every map.",
  "params": [
    {
      "name": "hover",
      "select": {
        "type": "point",
        "on": "mouseover",
        "clear": "mouseout",
        "fields": [
          "state_name"
        ]
      },
      "views": [
        "map_walking_recreational",
        "map_bush_walking",
        "map_cycling",
        "map_mountain_biking"
      ]
    }
  ],
  "columns": 4,
  "spacing": 20,
  "concat": [
    {
      "width": 240,
      "height": 206,
      "title": {
        "text": [
          "Walking for fun",
          "Australia 50.2%"
        ],
        "fontSize": 12,
        "lineHeight": 15
      },
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -132,
          0
        ]
      },
      "layer": [
        {
          "name": "map_walking_recreational",
          "data": {
            "url": "Data/aus_states.topojson",
            "format": {
              "type": "topojson",
              "feature": "states"
            }
          },
          "transform": [
            {
              "calculate": "datum.properties.STATE_NAME",
              "as": "state_name"
            },
            {
              "lookup": "state_name",
              "from": {
                "data": {
                  "url": "Data/ausplay_state_2025.csv",
                  "format": {
                    "type": "csv"
                  }
                },
                "key": "state_name",
                "fields": [
                  "state",
                  "walking_recreational",
                  "walking_recreational_caution"
                ]
              }
            },
            {
              "calculate": "'Australia'",
              "as": "country"
            },
            {
              "lookup": "country",
              "from": {
                "data": {
                  "url": "Data/ausplay_state_2025.csv",
                  "format": {
                    "type": "csv"
                  }
                },
                "key": "state_name",
                "fields": [
                  "walking_recreational"
                ]
              },
              "as": [
                "national"
              ]
            },
            {
              "calculate": "toNumber(datum['walking_recreational'])",
              "as": "percent"
            },
            {
              "calculate": "datum.percent / toNumber(datum.national)",
              "as": "ratio"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "#5A6067",
            "strokeWidth": 0.4
          },
          "encoding": {
            "color": {
              "field": "ratio",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0.5,
                  1,
                  2
                ],
                "range": [
                  "#e8e7f3",
                  "#9e9bcb",
                  "#383869"
                ],
                "interpolate": "rgb",
                "clamp": true
              },
              "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "title": null,
                "gradientLength": 110,
                "gradientThickness": 8,
                "values": [
                  0.5,
                  1,
                  2
                ],
                "labelExpr": "datum.value == 0.5 ? 'half' : datum.value == 1 ? 'average' : 'double'"
              }
            },
            "opacity": {
              "condition": {
                "param": "hover",
                "empty": true,
                "value": 1
              },
              "value": 0.3
            },
            "tooltip": [
              {
                "field": "state_name",
                "title": "State"
              },
              {
                "field": "percent",
                "title": "Walking for fun (%)",
                "format": ".1f"
              },
              {
                "field": "ratio",
                "title": "× Australia's average",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "data": {
            "url": "Data/states.csv",
            "format": {
              "type": "csv",
              "parse": {
                "label_lon": "number",
                "label_lat": "number"
              }
            }
          },
          "transform": [
            {
              "lookup": "state_name",
              "from": {
                "data": {
                  "url": "Data/ausplay_state_2025.csv",
                  "format": {
                    "type": "csv"
                  }
                },
                "key": "state_name",
                "fields": [
                  "state",
                  "walking_recreational",
                  "walking_recreational_caution"
                ]
              }
            },
            {
              "calculate": "'Australia'",
              "as": "country"
            },
            {
              "lookup": "country",
              "from": {
                "data": {
                  "url": "Data/ausplay_state_2025.csv",
                  "format": {
                    "type": "csv"
                  }
                },
                "key": "state_name",
                "fields": [
                  "walking_recreational"
                ]
              },
              "as": [
                "national"
              ]
            },
            {
              "calculate": "toNumber(datum['walking_recreational'])",
              "as": "percent"
            },
            {
              "calculate": "datum.percent / toNumber(datum.national)",
              "as": "ratio"
            },
            {
              "calculate": "format(datum.percent, '.1f') + (datum['walking_recreational_caution'] == 'yes' ? '*' : '')",
              "as": "label"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 10,
            "fontWeight": 600
          },
          "encoding": {
            "longitude": {
              "field": "label_lon"
            },
            "latitude": {
              "field": "label_lat"
            },
            "text": {
              "field": "label"
            },
            "color": {
              "condition": {
                "test": "datum.ratio > 1.4 && datum.state != 'ACT' && datum.state != 'TAS'",
                "value": "#FFFFFF"
              },
              "value": "#1D2125"
            }
          }
        }
      ]
    },
