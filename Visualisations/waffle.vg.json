{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 10. The 115 listed rail trails, one square each, by listed access.",
  "width": "container",
  "height": 240,
  "data": {
    "url": "Data/trails.csv",
    "format": {
      "type": "csv",
      "parse": {
        "km": "number",
        "wheelchair": "number",
        "pram": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.type == 'Rail trail'"
    },
    {
      "calculate": "datum.wheelchair == 1 ? 'Wheelchair suitable' : datum.pram == 1 ? 'Pram only' : 'Neither listed'",
      "as": "access"
    },
    {
      "calculate": "indexof(['Wheelchair suitable', 'Pram only', 'Neither listed'], datum.access)",
      "as": "access_order"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "position"
        }
      ],
      "sort": [
        {
          "field": "access_order"
        },
        {
          "field": "name"
        }
      ]
    },
    {
      "calculate": "(datum.position - 1) % 12",
      "as": "col"
    },
    {
      "calculate": "floor((datum.position - 1) / 12)",
      "as": "row"
    },
    {
      "calculate": "datum.col + 0.86",
      "as": "col_end"
    },
    {
      "calculate": "datum.row + 0.86",
      "as": "row_end"
    }
  ],
  "encoding": {
    "x": {
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          19.5
        ],
        "nice": false,
        "zero": true
      },
      "axis": null
    },
    "y": {
      "type": "quantitative",
      "scale": {
        "domain": [
          10,
          0
        ],
        "nice": false
      },
      "axis": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 1.5
      },
      "encoding": {
        "x": {
          "field": "col"
        },
        "x2": {
          "field": "col_end"
        },
        "y": {
          "field": "row"
        },
        "y2": {
          "field": "row_end"
        },
        "color": {
          "field": "access",
          "type": "nominal",
          "scale": {
            "domain": [
              "Wheelchair suitable",
              "Pram only",
              "Neither listed"
            ],
            "range": [
              "#A0522D",
              "#caa794",
              "#ECECE9"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Trail"
          },
          {
            "field": "states",
            "title": "State"
          },
          {
            "field": "km",
            "title": "Length (km)"
          },
          {
            "field": "access",
            "title": "Access"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "trails"
            }
          ],
          "groupby": [
            "access"
          ]
        },
        {
          "calculate": "datum.access == 'Wheelchair suitable' ? 1.9 : datum.access == 'Pram only' ? 3.45 : 6.9",
          "as": "label_y"
        },
        {
          "calculate": "datum.trails + (datum.access == 'Wheelchair suitable' ? ' wheelchair' : datum.access == 'Pram only' ? ' pram only' : ' neither')",
          "as": "label"
        },
        {
          "calculate": "12.4",
          "as": "label_x"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "label_x"
        },
        "y": {
          "field": "label_y"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 12.2,
            "y": 0.05,
            "y2": 3.25
          },
          {
            "x": 12.2,
            "y": 3.15,
            "y2": 3.85
          },
          {
            "x": 12.2,
            "y": 4.05,
            "y2": 9.85
          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "rule",
        "color": "#5A6067"
      },
      "encoding": {
        "x": {
          "field": "x"
        },
        "y": {
          "field": "y"
        },
        "y2": {
          "field": "y2"
        }
      }
    }
  ],
  "config": {
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5A6067",
      "titleColor": "#5A6067",
      "domainColor": "#E1E2DF",
      "tickColor": "#E1E2DF",
      "gridColor": "#E1E2DF",
      "labelFontSize": 11.5,
      "titleFontSize": 11.5,
      "titleFontWeight": 500
    },
    "axisLeft": {
      "minExtent": 150,
      "maxExtent": 150,
      "labelLimit": 142
    },
    "legend": {
      "labelColor": "#5A6067",
      "titleColor": "#5A6067",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500
    },
    "title": {
      "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "fontSize": 13,
      "fontWeight": 600,
      "color": "#1D2125",
      "anchor": "start"
    },
    "text": {
      "font": "\"IBM Plex Mono\", monospace",
      "fontSize": 10.5,
      "color": "#1D2125"
    }
  }
}
